# ---- ALLPACA server ----
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env

# Puerto del API
PORT=3000

# Postgres (servicio local "postgresql-x64-18")
PGHOST=localhost
PGPORT=5432
PGDATABASE=allpaca
PGUSER=allpaca
PGPASSWORD=cambia_esta_password

# Secretos — NUNCA subir esto a git
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secret_en_produccion_min_32_chars
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por comas.
# OBLIGATORIO en producción: sin esto el API arranca con el CORS abierto.
# En desarrollo ya se permiten http://localhost:4200 y :5173, no hace falta ponerlos.
# CORS_ORIGINS=https://allpaca.mx,https://www.allpaca.mx

NODE_ENV=development
